---
import type { Track } from "../config/tracks";

interface Props {
  track: Track;
}

const { track } = Astro.props;
---

<article class="track-card" style={`--track-accent: var(--track-${track.accent})`}>
  <span class="track-card__emoji" aria-hidden="true">{track.emoji}</span>
  <h3 class="track-card__title">{track.name}</h3>
  <p class="track-card__summary">{track.summary}</p>
  <ul class="track-card__services" aria-label="Servicios de AWS que se usan">
    {track.services.map((service) => <li class="chip">{service}</li>)}
  </ul>
  <div class="track-card__cta">
    <a class="btn btn--primary" href={`/${track.id}/arquitectura`}>
      Ver la guía del track
    </a>
  </div>
</article>
