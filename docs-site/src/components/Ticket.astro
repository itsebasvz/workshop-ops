---
/**
 * El billete del evento.
 *
 * Antes esto eran tres tarjetas sueltas —cuándo, dónde, formato— más la cuenta
 * atrás por su cuenta: cuatro cajas grises diciendo cuatro cosas del mismo
 * hecho. Aquí van juntas en un objeto reconocible, con su troquelado y su talón.
 * Es la única pieza de la portada que se permite ser figurativa.
 */
import { EVENT } from "../config/event";
import Countdown from "./Countdown.astro";
---

<aside class="ticket">
  <div class="ticket__stub">
    <p class="ticket__kicker">{EVENT.name}</p>

    <p class="ticket__date">
      <span class="ticket__weekday">{EVENT.weekdayLabel}</span>
      <span class="ticket__day">{EVENT.dayNumber}</span>
      <span class="ticket__month">{EVENT.monthLabel}</span>
    </p>

    <p class="ticket__time">{EVENT.timeLabel}</p>
  </div>

  <div class="ticket__perf" aria-hidden="true"></div>

  <div class="ticket__body">
    <p class="ticket__row">
      <span class="ticket__label">Sede</span>
      <a class="ticket__value" href={EVENT.venue.mapsUrl}>{EVENT.venue.name}</a>
      <span class="ticket__note">{EVENT.venue.address}</span>
    </p>

    <p class="ticket__row">
      <span class="ticket__label">Formato</span>
      <span class="ticket__value">Presencial, en equipos</span>
      <span class="ticket__note">{EVENT.durationLabel} · cupo limitado</span>
    </p>

    <div class="ticket__countdown">
      <span class="ticket__label">Faltan</span>
      <Countdown />
    </div>
  </div>
</aside>
