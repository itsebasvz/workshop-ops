---
/**
 * Un track, a lo ancho.
 *
 * Sustituye a la tarjeta pequeña: con un solo track publicado, una tarjeta
 * estrecha en una rejilla de dos columnas dejaba medio ancho vacío. El panel
 * usa ese espacio para poner la arquitectura al lado de la descripción, que es
 * justo lo que hace falta para decidir si el track te interesa.
 */
import type { Track } from "../config/tracks";
import Flow from "./Flow.astro";

interface Props {
  track: Track;
}

const { track } = Astro.props;
---

<article class="panel" style={`--track-accent: var(--track-${track.accent})`}>
  <div class="panel__main">
    <p class="panel__kicker">
      <span aria-hidden="true">{track.emoji}</span> Track
    </p>

    <h3 class="panel__title">{track.name}</h3>
    <p class="panel__summary">{track.summary}</p>

    <ul class="panel__services" aria-label="Servicios de AWS que se usan">
      {track.services.map((service) => <li class="chip">{service}</li>)}
    </ul>

    <a class="btn btn--primary panel__cta" href={`/${track.id}/arquitectura`}>
      Ver la guía del track
      <span class="btn__arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="panel__aside">
    <p class="panel__aside-title">El camino de una petición</p>
    <Flow track={track} />
  </div>
</article>
